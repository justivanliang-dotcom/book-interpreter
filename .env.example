# LLM 配置模板：复制为 .env 并填入真实密钥
# 复制命令：Copy-Item .env.example .env
#
# 注意：代码默认走 https://api.openai.com/v1（国内网络通常不可达，会超时）。
# 使用 DeepSeek 等国内服务商时，LLM_BASE_URL 和 LLM_MODEL 两项必须设置！

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 公网部署安全配置（本地开发可留空）
# 访问口令：留空则关闭鉴权，公网部署务必设置
ACCESS_TOKEN=
# 每 IP 每分钟 API 请求上限
RATE_LIMIT_PER_MINUTE=30
# 每 IP 每天 LLM 调用上限（浓缩/讲解/问答合计）
DAILY_LLM_LIMIT=100
